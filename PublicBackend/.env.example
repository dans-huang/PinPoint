# PinPoint-owned secrets. Never commit a populated .env file.
# The public, single-Mac setup must opt in explicitly. If this setting is
# omitted, the backend defaults securely to hosted mode and exposes only the
# Sign in with Apple + invitation flow.
PINPOINT_AUTH_MODE=self_hosted

PINPOINT_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Stable identity key. Keep this value through session-key rotations; changing
# it requires an explicit user-id migration.
PINPOINT_USER_ID_SECRET_V1=replace-with-a-different-32-byte-random-value
# Hosted mode only. Leave these blank for self_hosted mode.
PINPOINT_APPLE_AUDIENCE=
# Public Universal Link. Both settings are optional for local custom-scheme
# development and required together for an invited HTTPS deployment. The App
# ID is APPLE_TEAM_ID followed by the exact bundle id above.
PINPOINT_INVITE_BASE_URL=
PINPOINT_APPLE_APP_ID=

# Apple refresh-token custody is deliberately OFF unless every private value
# below is present. Enabling it makes the backend exchange the one-time Apple
# authorization code, verify the returned Apple identity is the same user, and
# retain only an AES-GCM ciphertext in the private SQLite ledger. This is
# preparation for a future revocation flow; it does not enable account deletion.
PINPOINT_APPLE_TOKEN_CUSTODY_ENABLED=false
# Required only when the switch above is true. Keep the downloaded .p8 outside
# the repository, make it readable only by the backend service account (0600),
# and use its absolute path inside the backend container or host.
PINPOINT_APPLE_TEAM_ID=ABCDE12345
PINPOINT_APPLE_KEY_ID=ABCDE12345
PINPOINT_APPLE_PRIVATE_KEY_PATH=/run/secrets/pinpoint_apple_auth_key.p8
# URL-safe base64 for exactly 32 random bytes. This must be independent from
# both PinPoint secrets above and backed up with the encrypted ledger.
PINPOINT_APPLE_REFRESH_TOKEN_KEY_V1=replace-with-urlsafe-base64-for-32-random-bytes
# Optional legacy bootstrap invitations. New deployments should leave this
# empty and create expiring one-time invitations with `pinpoint_backend.admin
# invite create`; managed invitation verifiers live in the durable ledger and
# become active without restarting the service. Never commit or log raw codes.
PINPOINT_INVITE_CODES=

# After the backend is healthy, create the local app's one-use code with:
#   python -m pinpoint_backend.admin activation create
# The code expires after exactly 10 minutes and is stored only as an HMAC
# verifier. The activation endpoint accepts direct loopback requests only.

# Durable security/ownership ledger. Production workers must share this file
# on one persistent volume; do not use ephemeral storage. Run one persistent
# backend replica as a dedicated service account, with a 0700 parent directory
# and 0600 SQLite, WAL, and SHM files.
PINPOINT_STATE_DB_PATH=/var/lib/pinpoint/pinpoint.sqlite3

# Complete-upload currently returns Plaud or S3 URLs. Keep this allowlist narrow.
PINPOINT_AUDIO_HOST_SUFFIXES=amazonaws.com,plaud.ai

# Shared-cost circuit breakers. These byte/file limits do not replace trusted
# duration and transcription-minute limits; keep open signup disabled.
PINPOINT_MAX_AUDIO_BYTES=268435456
PINPOINT_USER_DAILY_RECORDING_LIMIT=20
PINPOINT_GLOBAL_DAILY_RECORDING_LIMIT=200
PINPOINT_USER_ACTIVE_RECORDING_LIMIT=3
PINPOINT_USER_DAILY_AUDIO_BYTES_LIMIT=1073741824
PINPOINT_GLOBAL_DAILY_AUDIO_BYTES_LIMIT=10737418240
# A live Mac renews this lease before every direct-to-Plaud upload part. If a
# Mac disappears, another installation can safely take over after ten minutes.
PINPOINT_UPLOAD_ATTEMPT_LEASE_SECONDS=600

# Public API abuse controls. These are backend-wide fixed windows because the
# one persistent replica shares one private SQLite ledger. Per-IP rows contain
# only a domain-separated HMAC digest, never the raw client address.
PINPOINT_MAX_REQUEST_BODY_BYTES=4194304
PINPOINT_GLOBAL_REQUEST_LIMIT=600
PINPOINT_GLOBAL_REQUEST_WINDOW_SECONDS=60
PINPOINT_NONCE_IP_LIMIT=30
PINPOINT_NONCE_IP_WINDOW_SECONDS=60
PINPOINT_APPLE_SIGNIN_IP_LIMIT=10
PINPOINT_APPLE_SIGNIN_IP_WINDOW_SECONDS=300

# Plaud Partner credentials. These stay on the backend.
PLAUD_CLIENT_ID=client_replace_me
PLAUD_CLIENT_SECRET=sk_replace_me
PLAUD_API_KEY=replace_me
PLAUD_API_DOMAIN=platform-us.plaud.ai
# The Mac must receive a raw Plaud SDK bearer. Request the shortest lifetime
# Plaud confirms it supports; the hosted default is one hour.
PLAUD_USER_TOKEN_TTL_SECONDS=3600

# Session policy.
PINPOINT_SESSION_TTL_SECONDS=86400
PINPOINT_SESSION_ABSOLUTE_TTL_SECONDS=2592000
PINPOINT_NONCE_TTL_SECONDS=300

# Optional PinPoint-owned summaries, templates, and vocabulary improvement.
# Leave all three blank to keep transcript sync working without AI summaries.
# The key stays on the backend and is never shipped in the app.
PINPOINT_INTELLIGENCE_BASE_URL=
PINPOINT_INTELLIGENCE_API_KEY=
PINPOINT_INTELLIGENCE_MODEL=
PINPOINT_INTELLIGENCE_TIMEOUT_SECONDS=60
PINPOINT_INTELLIGENCE_MAX_TRANSCRIPT_CHARS=200000
PINPOINT_INTELLIGENCE_MAX_OUTPUT_CHARS=20000
# Persisted per-user model-cost and concurrency circuit breakers. Idempotent
# replays do not spend another daily slot.
PINPOINT_INTELLIGENCE_USER_ACTIVE_GENERATION_LIMIT=2
PINPOINT_INTELLIGENCE_USER_DAILY_GENERATION_LIMIT=40
